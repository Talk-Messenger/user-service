SPRING_PROFILES_ACTIVE=dev
APP_PORT=8080

CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

TOKEN_PAIR_ID_CLAIM=tokenPairId
TOKEN_TYPE_CLAIM=tokenType
ACCESS_TOKEN_TYPE=access
REFRESH_TOKEN_TYPE=refresh

# ВНИМАНИЕ: сгенерируйте собственную пару EC-ключей для prod, не используйте дефолтные из репозитория
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=864000

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/user
SPRING_DATASOURCE_DB=user
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=user
